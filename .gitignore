# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
src/generated/
next-env.d.ts

# Modul eksternal. Isi folder ini datang dari repo modul sendiri lewat
# `npm run module:add <alias>` (scripts/module-add.mjs), bukan dari repo core —
# supaya core yang sama bisa dipakai aplikasi dengan modul berbeda. Folder ini
# di-ignore utuh karena TIDAK ada lagi file core di dalamnya; manifest core
# tinggal di src/core/manifests/.
/src/modules/

# Terjemahan milik modul eksternal. Namespace `module-*` hanya dirujuk dari
# manifest modul, jadi tidak boleh ikut ter-track di core. Namespace aplikasi
# (common, profile, settings, admin-panel-*, …) tetap tracked.
/src/services/i18n/locales/*/module-*.json
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

*storybook.log
/storybook-static
.codegpt

# CodeGraph index
.codegraph/